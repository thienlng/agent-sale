<!doctype html>
<html lang="vi">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Rapiz | AI hỗ trợ tư vấn bán hàng 24/7</title>
<meta name="description" content="Rapiz hỗ trợ trả lời khách hàng theo thông tin sản phẩm và chính sách của bạn. Tư vấn ngoài giờ, ghi nhận nhu cầu và chuyển cho nhân viên khi cần."/>
<meta name="theme-color" content="#ffffff"/>
<script is:inline>
(() => {
 let saved;
 try { saved = localStorage.getItem('rapiz-theme'); } catch {}
 const theme = saved === 'light' || saved === 'dark' ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
 document.documentElement.dataset.theme = theme;
 document.querySelector('meta[name="theme-color"]').setAttribute('content', theme === 'dark' ? '#151615' : '#ffffff');
})();
</script><link rel="icon" href="/images/rapiz-logo.jpeg"/>
<link rel="preload" href="/fonts/fraunces/fraunces-normal-variable.woff2" as="font" type="font/woff2" crossorigin/>
</head>
<body>
<a class="skip" href="#main">Đến nội dung chính</a>
<header class="header wrap">
<a class="brand" href="#" aria-label="Rapiz trang chủ"><span class="brand-icon"><img src="/images/rapiz-logo.jpeg" alt="" width="102" height="76"/></span>rapiz</a>
<nav aria-label="Điều hướng chính" id="navigation"><a href="#product">Sản phẩm</a><a href="#solutions">Ứng dụng</a><a href="#how-it-works">Cách bắt đầu</a><a href="#faq">Hỏi đáp</a><a class="nav-login-mobile" href={loginUrl}>Đăng nhập</a></nav>
<button class="theme-toggle" type="button" aria-label="Bật giao diện tối" aria-pressed="false" title="Bật giao diện tối">
<svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 13.4A8.5 8.5 0 0 1 10.6 3.5a8.5 8.5 0 1 0 9.9 9.9Z"/></svg>
<svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
</button><a class="nav-login" href={loginUrl}>Đăng nhập</a><a class="nav-cta" href={signupUrl}>Dùng thử miễn phí</a><button class="menu-toggle" aria-expanded="false" aria-controls="navigation" aria-label="Mở menu">☰</button>
</header>
<main id="main" class="wrap">
<section class="hero">
