<script>
const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
const colorPreference = matchMedia('(prefers-color-scheme: dark)');
function savedTheme() {
 try { return localStorage.getItem('rapiz-theme'); } catch { return null; }
}
function applyTheme(theme: 'dark' | 'light') {
 document.documentElement.dataset.theme = theme;
 const dark = theme === 'dark';
 themeToggle.setAttribute('aria-pressed', String(dark));
 const label = dark ? 'Bật giao diện sáng' : 'Bật giao diện tối';
 themeToggle.setAttribute('aria-label', label);
 themeToggle.title = label;
 document.querySelector('meta[name="theme-color"]')!.setAttribute('content', dark ? '#151615' : '#ffffff');
}
function applyPreference() {
 const saved = savedTheme();
 applyTheme(saved === 'dark' || saved === 'light' ? saved : (colorPreference.matches ? 'dark' : 'light'));
}
applyPreference();
themeToggle.addEventListener('click', () => {
 const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
 try { localStorage.setItem('rapiz-theme', theme); } catch {}
 applyTheme(theme);
});
colorPreference.addEventListener('change', () => { const saved = savedTheme(); if (saved !== 'dark' && saved !== 'light') applyPreference(); });
window.addEventListener('storage', event => { if (event.key === 'rapiz-theme' || event.key === null) applyPreference(); });
const scenarios = {
 fashion: { customer:'Mình cao 1m62, thích áo mặc thoải mái. Shop tư vấn giúp mình nhé?', bot:'Dạ, bạn thích form rộng thì mẫu Everyday Tee sẽ hợp đó ạ. Bạn cho mình xin cân nặng để tư vấn size chính xác hơn nhé!', name:'Everyday Tee', detail:'Cotton mềm mại, form rộng', label:'Sản phẩm gợi ý', symbol:'' },
 beauty: { customer:'Mình muốn tìm sản phẩm dưỡng ẩm, da mình khá nhạy cảm.', bot:'Mình hiểu rồi ạ. Để gợi ý theo thông tin sản phẩm của shop, bạn cho mình biết da đang thiên khô hay thiên dầu và có thành phần nào cần tránh không nhé?', name:'Tìm sản phẩm dưỡng ẩm', detail:'Hỏi thêm loại da và thành phần cần tránh', label:'Tư vấn làm đẹp', symbol:'✳' },
 education: { customer:'Mình đi làm rồi, muốn học tiếng Anh buổi tối thì có lớp nào phù hợp?', bot:'Dạ, mình sẽ giúp bạn tìm lớp theo lịch học của trung tâm. Bạn muốn tập trung giao tiếp hay luyện thi, và thường rảnh những buổi tối nào ạ?', name:'Tìm lớp tiếng Anh buổi tối', detail:'Hỏi mục tiêu học và lịch rảnh', label:'Tư vấn khóa học', symbol:'Aa' },
 service: { customer:'Mình muốn tìm hiểu gói dịch vụ cho đội ngũ 10 người.', bot:'Dạ, bạn cho mình biết đội ngũ đang cần hỗ trợ công việc gì nhé? Mình sẽ ghi nhận nhu cầu và kết nối bạn với tư vấn viên để trao đổi gói phù hợp.', name:'Chuyển cho nhân viên tư vấn', detail:'Ghi nhận nhu cầu của đội ngũ', label:'Tư vấn dịch vụ', symbol:'⌘' }
};
const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-industry]')];
function selectIndustry(tab: HTMLButtonElement) {
 const key = tab.dataset.industry as keyof typeof scenarios;
 const data = scenarios[key];
 tabs.forEach(t => {t.setAttribute('aria-selected', String(t === tab));t.tabIndex=t===tab?0:-1;});
 document.querySelector('#conversation')!.setAttribute('aria-labelledby',tab.id);
 for(const [id,value] of [['customer-message',data.customer],['bot-message',data.bot],['product-name',data.name],['product-detail',data.detail],['product-label',data.label]]) document.getElementById(id)!.textContent=value;
 const symbol=document.getElementById('product-symbol')!;symbol.textContent=data.symbol;symbol.hidden=!data.symbol;
 document.querySelector<SVGElement>('.product-art svg')!.style.display=data.symbol?'none':'block';
}
tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>selectIndustry(tab));tab.addEventListener('keydown',(event)=>{let next=index;if(event.key==='ArrowRight')next=(index+1)%tabs.length;else if(event.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();tabs[next].focus();selectIndustry(tabs[next]);});});
const dialog=document.querySelector<HTMLDialogElement>('#contact-dialog')!;
document.querySelectorAll('[data-contact]').forEach(button=>button.addEventListener('click',()=>dialog.showModal()));
document.querySelector('.dialog-close')!.addEventListener('click',()=>dialog.close());
dialog.addEventListener('click',event=>{if(event.target===dialog){const rect=dialog.getBoundingClientRect();if(event.clientX<rect.left||event.clientX>rect.right||event.clientY<rect.top||event.clientY>rect.bottom)dialog.close();}});
function showDemo(){dialog.close();document.getElementById('solutions')!.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});tabs[0].focus({preventScroll:true});}
document.querySelectorAll('[data-demo]').forEach(button=>button.addEventListener('click',showDemo));
document.querySelector('#explore-demo')!.addEventListener('click',showDemo);
const menu=document.querySelector<HTMLButtonElement>('.menu-toggle')!;
menu.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));document.querySelector('#navigation')!.classList.toggle('open',open);menu.setAttribute('aria-label',open?'Đóng menu':'Mở menu');});
document.querySelectorAll('#navigation a').forEach(link=>link.addEventListener('click',()=>{menu.setAttribute('aria-expanded','false');menu.setAttribute('aria-label','Mở menu');document.querySelector('#navigation')!.classList.remove('open');}));
if(matchMedia('(prefers-reduced-motion: reduce)').matches){const rabbit=document.querySelector<HTMLImageElement>('.rabbit');if(rabbit)rabbit.src='/images/rapiz-rabbit-still.png';}
</script>
</body></html>
