<div class="hero-actions"><a class="button primary" href={signupUrl}>Dùng thử miễn phí</a><button class="button secondary" data-demo>Xem Rapiz tư vấn</button></div>
<div class="hero-scene">
<img class="rabbit" src="/images/rapiz-rabbit.gif" alt="Chú thỏ trắng Rapiz chuyển động trên nền cam" width="800" height="600" fetchpriority="high"/>
