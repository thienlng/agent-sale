---
import '../styles/typography.css';
import '../styles/global.css';
import '../styles/theme.css';
import '../styles/app-links.css';
import { loginUrl, signupUrl } from '../lib/app-links';
const assetBase = '/images/friends/';
const capabilityArt = [
 {src:'rabbit-rest.jpeg', width:735, height:542, title:'Trả lời ngoài giờ', text:'Khách nhắn lúc tối muộn vẫn được hỗ trợ, kể cả khi đội ngũ đã hết ca.'},
 {src:'curious-rabbit.webp', still:'curious-rabbit-still.png', width:480, height:360, title:'Theo sát cuộc trò chuyện', text:'Giữ ngữ cảnh để hỏi thêm và trả lời khi khách tiếp tục trao đổi.'},
 {src:'rabbit-hug.jpeg', width:690, height:794, title:'Ghi nhận nhu cầu', text:'Lưu thông tin khách chia sẻ để nhân viên có cơ sở tư vấn và chăm sóc tiếp.'},
 {src:'bouncing-rabbit.webp', still:'bouncing-rabbit-still.png', width:480, height:360, title:'Phù hợp với từng ngành', text:'Thiết lập kiến thức riêng cho cửa hàng, trung tâm giáo dục hoặc doanh nghiệp dịch vụ.'},
];
const channels = ['Facebook', 'Zalo', 'Instagram', 'TikTok', 'Website'];
const faqs = [
 ['Rapiz trả lời khách dựa trên thông tin nào?', 'Rapiz sử dụng thông tin sản phẩm, tài liệu, bảng giá và chính sách bạn cung cấp. Bạn có thể kiểm tra câu trả lời bằng hội thoại thử trước khi đưa vào sử dụng.'],
 ['Rapiz phù hợp với ngành nào?', 'Các cửa hàng bán lẻ, thời trang, mỹ phẩm hoặc doanh nghiệp giáo dục và dịch vụ có nhiều câu hỏi lặp lại từ khách hàng. Mỗi ngành cần thông tin và hướng dẫn tư vấn riêng.'],
 ['Khi nào cần nhân viên tiếp nhận?', 'Khi khách cần tư vấn chuyên sâu, yêu cầu gặp nhân viên hoặc hỏi ngoài phạm vi kiến thức đã cung cấp. Nhân viên tiếp tục trao đổi dựa trên ngữ cảnh sẵn có.'],
 ['Có thể kết nối những kênh nào?', 'Facebook, Zalo OA, Instagram, TikTok và website nằm trong phạm vi đa kênh của Rapiz. Kênh có thể sử dụng sẽ được xác nhận khi triển khai, tùy quyền tài khoản và phê duyệt của nền tảng.'],
 ['Tôi cần chuẩn bị gì trước khi dùng?', 'Bạn cần thông tin sản phẩm, chính sách bán hàng, những câu hỏi khách thường hỏi và quyền quản trị kênh muốn kết nối. Hãy chọn thêm người phụ trách tiếp nhận khi khách cần gặp nhân viên.'],
 ['Tôi có thể dùng thử không?', 'Có. Bạn có thể tạo tài khoản miễn phí để thử Rapiz với thông tin cửa hàng của mình. Các cuộc hội thoại ở phần “Xem demo” trên trang này là ví dụ minh họa, chưa kết nối AI trực tiếp.'],
];
