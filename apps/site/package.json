{
  "name": "@agent-sales/site",
  "version": "0.0.0",
  "private": true,
  "description": "Rapiz marketing site (Astro, static output).",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "typecheck": "astro sync && tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "serve:tunnel": "PUBLIC_APP_URL=/ SITE_OUT_DIR=./dist-tunnel astro build && SITE_OUT_DIR=./dist-tunnel astro preview --port 4323 --host 127.0.0.1 --ignore-lock"
  },
  "dependencies": {
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
