    "lint": "eslint src"
  },
  "dependencies": {
    "@agent-sales/shared": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "es-check": "^9.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
