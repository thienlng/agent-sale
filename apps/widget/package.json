{
  "name": "@agent-sales/widget",
  "version": "0.0.0",
  "private": true,
  "description": "Embeddable website chat widget: one ES2017 script, Shadow DOM, polling (ADR-011)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && pnpm run syntax && pnpm run size",
    "size": "node scripts/size.mjs",
    "syntax": "es-check es2017 dist/widget.js",
