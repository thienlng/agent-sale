{
  "name": "@agent-sales/web",
  "version": "0.0.0",
  "private": true,
  "description": "Dashboard SPA: Vite + React 19 + TanStack Router/Query + Tailwind v4 (ADR-009). Served as static files from the CDN.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "size": "node scripts/check-bundle-size.mjs",
    "test:e2e:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@agent-sales/contracts": "workspace:*",
    "@agent-sales/i18n": "workspace:*",
    "@agent-sales/shared": "workspace:*",
    "@agent-sales/ui": "workspace:*",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.160.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^25.0.0",
    "lucide-react": "^1.61.0",
    "qrcode": "1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.0.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/router-plugin": "^1.160.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^27.0.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
