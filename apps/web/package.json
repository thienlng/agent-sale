{
  "name": "@agent-sales/web",
  "version": "0.0.0",
  "private": true,
  "description": "Dashboard SPA: Vite + React 19 + TanStack Router/Query + Tailwind v4 (ADR-009). Served as static files from the CDN.",
  "type": "module",
  "scripts": {
    "dev": "vite",
