{
  "name": "agent-sales",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI Sales Agent platform for Vietnamese SMEs — monorepo",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "check": "pnpm lint && pnpm arch && pnpm typecheck && pnpm test && pnpm build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "arch": "depcruise --config .dependency-cruiser.cjs apps packages",
    "arch:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot apps packages | dot -T svg > docs/reference/dependency-graph.svg",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "gen": "turbo gen",
    "todo:new": "bash scripts/new-todo.sh",
    "verify": "bash scripts/verify-setup.sh",
    "prepare": "husky",
    "test:integration": "turbo run test:integration",
    "db:migrate": "pnpm --filter @agent-sales/db db:migrate",
    "db:migrate:dev": "pnpm --filter @agent-sales/db db:migrate:dev",
    "infra:up": "docker compose -f infra/docker/docker-compose.local.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker/docker-compose.local.yml down"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.30.0",
    "@turbo/gen": "^2.5.4",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
