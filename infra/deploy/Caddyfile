# Public entry point. One host serves everything, like scripts/dev-tunnel-proxy.mjs:
#   /api/*      -> api        /webhooks/* -> webhook     /media/* -> object storage (read only)
#   /widget.js  -> widget     / and site assets -> marketing site     else -> dashboard SPA
# Plain HTTP on :80: the server's reverse proxy (Nginx Proxy Manager) terminates HTTPS for the
# public host and forwards here, so the image knows nothing about the domain.
{
	auto_https off
	# Only NPM (a private Docker address) is believed. Strict mode reads X-Forwarded-For from the
	# right, so a value the client wrote itself never becomes the client IP. reverse_proxy appends
	# NPM's address for the upstreams, which trust the same private ranges (TRUST_PROXY).
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	encode zstd gzip
	# Security headers (docs/09-security-and-compliance.md §6). HSTS without includeSubDomains:
	# not every subdomain of the public host is known to serve HTTPS (docs/runbooks/deploy-vps.md).
	# Nothing here may be framed (the widget is a Shadow DOM script, not an iframe, ADR-011).
	# Removing Server defers this block to the response, so the CSP is only a default ("?"): the
	# stricter policies set by the site and /media routes below win.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), interest-cohort=()"
		?Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		-Server
	}

	# Legacy OAuth redirect path registered on the Meta app.
	handle /api/channels/oauth/* {
		uri replace /api/channels/oauth/ /api/v1/channels/oauth/ 1
		reverse_proxy api:3000
	}
	# Readiness is for the container network only (compose healthchecks, docs/runbooks/deploy-vps.md).
	handle /api/v1/health/ready {
		respond 404
	}
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /webhooks/* {
		reverse_proxy webhook:3001
	}

	# Public product pictures for Meta. Reads only; the anonymous S3 identity cannot list.
	# Uploaded files never run as a page on this origin: a sandboxed, script-less document at most,
	# and anything that is not a picture or a video downloads instead of rendering.
	handle_path /media/* {
		@write not method GET HEAD
		respond @write 405
		@query expression {query} != ""
		respond @query 404
		header Content-Security-Policy "sandbox; default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; frame-ancestors 'none'"
		# Caddy's path matcher ignores case, so PHOTO.PNG renders and page.HTML downloads
		# (infra/deploy/test/edge-headers.sh checks both).
		@download not path *.jpg *.jpeg *.png *.webp *.gif *.avif *.mp4 *.webm *.mov
		header @download Content-Disposition attachment
		rewrite * /{$S3_BUCKET}{uri}
		reverse_proxy object-storage:8333 {
			header_down -Content-Disposition
		}
	}

	handle /widget.js {
		root * /srv/widget
		header Cache-Control "public, max-age=300"
		file_server
	}

	# Rapiz's own website chat bubble: the loader reads its site key from RAPIZ_SITE_WIDGET_KEY
	# (unset: the placeholder stays and no bubble loads). See apps/site/README.md "Website chat".
	handle /static/site-widget.js {
		root * /srv/site
		header Cache-Control "no-cache"
		templates {
			mime text/javascript application/javascript
		}
		file_server
	}

	# Marketing pages (apps/site/public). A folder path without its slash redirects to it.
	@site path / /index.html /images/* /fonts/* /static/* /nganh/* /tinh-nang/* /tich-hop /tich-hop/* /bao-mat /bao-mat/* /bang-gia /bang-gia/* /dat-lich-demo /dat-lich-demo/* /ve-rapiz /ve-rapiz/* /privacy /privacy/* /terms /terms/*
	# The site has no inline scripts; inline style attributes stay. Images and connections are wide
	# enough for the chat bubble (bot replies may show product pictures from other hosts). The
	# bubble must stay same-origin (/widget.js, /api): the edge passes only RAPIZ_SITE_WIDGET_KEY, so
	# the SRC and API placeholders of site-widget.js stay empty here. A site built with another
	# PUBLIC_RAPIZ_WIDGET_SRC/API origin must add it to script-src and connect-src.
	handle @site {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		root * /srv/site
		file_server
	}

	handle {
		root * /srv/web
		# Dashboard policy, report-only until verified in every flow (frame-ancestors and the rest
		# of the enforced site-wide policy above already apply). Pictures and videos come from
		# channel and shop CDNs; lodging videos embed YouTube and Google Drive players.
		header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://drive.google.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# The service worker, the app manifest and the preferences boot script must reach browsers
		# fresh (T-190).
		@fresh path /sw.js /manifest.webmanifest /boot.js
		header @fresh Cache-Control "no-cache"
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		@shell path /index.html
		header @shell Cache-Control "no-cache"
		file_server
	}
}
