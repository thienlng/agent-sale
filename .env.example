# Copy to .env for local development. Never commit real values.
# Each app validates its own env schema at boot (see apps/*/README.md).
NODE_ENV=development
LOG_LEVEL=debug

# Database (infra/docker/docker-compose.local.yml). Three logins (ADR-004):
#  - owner: runs migrations only
#  - rapiz_tenant (member of app_tenant): API, agent, tenant-scoped jobs — RLS-bound
#  - rapiz_system (member of app_system): ingress, scheduler, reconciliation, back-office
# `pnpm db:migrate:dev` creates the two app logins with these passwords.
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:5433/rapiz
DATABASE_URL=postgres://rapiz_tenant:rapiz_tenant_dev@localhost:5433/rapiz
DATABASE_SYSTEM_URL=postgres://rapiz_system:rapiz_system_dev@localhost:5433/rapiz
# Read-only SQL lane of the owner assistant (T-171); unset = lane off. Its login (member of
# app_assistant_sql only) is created by `pnpm db:migrate:dev` from this URL.
DATABASE_ASSISTANT_SQL_URL=postgres://rapiz_assistant:rapiz_assistant_dev@localhost:5433/rapiz
# Optional; defaults to DATABASE_SYSTEM_URL. Must be a DIRECT Postgres connection (not PgBouncer): the agent LISTENs on it.
# DATABASE_LISTEN_URL=postgres://rapiz_system:rapiz_system_dev@localhost:5433/rapiz

REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rapiz-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Email through Resend (ADR-023): signup and password codes, and notification emails (T-172).
# Unset: development logs code emails (with the code) instead of sending them; production sends
# nothing and logs a warning. Notification emails are skipped and the UI says email is unavailable.
# RESEND_API_KEY=
# EMAIL_FROM="Rapiz <noreply@rapiz.io>"
# Development only: also write every email as JSON here (the live e2e suite reads signup codes).
# MAIL_OUTBOX_DIR=/tmp/rapiz-mail
# Dashboard origin (https) used for links in notification emails.
# APP_PUBLIC_URL=https://app.example.com

# Sign in with Google: an OAuth "Web application" client (Google Cloud → Google Auth Platform).
# Register the redirect URI on the client exactly: http://localhost:5173/api/v1/auth/google/callback
# locally, https://rapiz.io/api/v1/auth/google/callback in production. Unset: the button shows
# "coming soon". GOOGLE_REDIRECT_URI defaults to the first APP_ORIGINS entry + that path.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Session checks (docs/09 §2): each API process re-reads a session (revoked? two-factor?) after
# this many ms, so a logout reaches the other processes within it (0 = every request).
# AUTH_SESSION_CACHE_TTL_MS=15000
# Step-up: how recent a password, code or Google sign-in must be for API key creation, data
# export and platform payment/plan changes.
# AUTH_STEP_UP_WINDOW_MINUTES=10
# Proxies whose X-Forwarded-For is trusted for the client IP (api and webhook): comma-separated
# addresses/CIDRs or loopback|linklocal|uniquelocal, or false. Unset: private ranges in production,
# loopback elsewhere. `true` and hop counts are refused.
# TRUST_PROXY=
# Extra disposable email domains that get no signup trial (comma-separated, subdomains included).
# TRIAL_BLOCKED_EMAIL_DOMAINS=

# LLM providers and tier routing are NOT configured here: platform admins manage them in the
# admin console (stored in llm_providers / llm_tier_routes, API keys encrypted). Without a route,
# development and tests use a deterministic fake model; production answers 503.
# Make yourself platform admin after signing up:
#   pnpm --filter @agent-sales/backend platform-admin grant you@example.com
#
# Encrypts secrets stored in the database (LLM API keys). 32 bytes base64: `openssl rand -base64 32`.
# Required in production; empty in development uses a fixed insecure key.
SECRETS_ENCRYPTION_KEY=

# ChatGPT-subscription sign-in of the Hermes runtime (Admin -> LLM). Unset = enabled outside
# production and DISABLED in production. Set to `true` in production only after the owner has
# confirmed that ChatGPT plans may back a hosted product (T-052, ADR-010). `false` forces it off.
# HERMES_SUBSCRIPTION_LOGIN=

# Bot vision (T-053): the bot downloads the customer's Messenger/Instagram images and sends them to
# the model through hermes-runtime. ON outside production, OFF in production unless `true`. The
# ChatGPT-plan login behind Hermes is for TESTING ONLY, so never enable this in production on it.
# BOT_IMAGE_VISION=
# HUMAN_AGENT tag (ADR-031): `true` lets a member's manual Messenger/Instagram reply go out between
# 24 hours and 7 days after the customer's last message. Needs Meta's Human Agent permission first.
# Off by default; bots and the care agent never use it.
# META_HUMAN_AGENT_TAG=
# Number check on bot replies (ADR-032, revisits ADR-015): `true` refuses a send_message or final
# reply stating a price or a number >= 1000 that is not in the shop's data or the tool results
# (rewrite once, then the fallback line). Off by default; the instruction-leak check is always on.
# BOT_REPLY_FIGURE_GUARD=
# Dev/test only (ignored in production): extra hosts the image fetcher may reach, comma separated.
# They skip the Meta-CDN allowlist and the private-address block and may use plain http, so tests can
# serve images from a loopback server (for example `127.0.0.1`).
# BOT_IMAGE_EXTRA_HOSTS=
# Dev/QA only: hosts the bot-action executor may call over plain http (ignored in production)
# ACTION_DEV_ALLOW_HTTP_HOSTS=

# Meta (Facebook/Instagram) inbox — docs/meta-inbox.md. All optional in development; the inbox
# shows "not configured" without them. Never commit real values.
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration id (omit to use classic scopes).
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v24.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Public HTTPS origin of the dashboard; OAuth popups post their result only to this origin.
META_APP_ORIGIN=
# Exact redirect URI registered on the Meta app, with a {provider} placeholder. Defaults to
# ${META_APP_ORIGIN}/api/v1/channels/oauth/{provider}/callback.
META_OAUTH_REDIRECT_URI=

# Public HTTPS base URL for bot media in object storage (sent to Meta as attachment URLs).
# Through the dev tunnel (scripts/dev-tunnel-proxy.mjs): S3_PUBLIC_URL=https://<tunnel host>/media
S3_PUBLIC_URL=

# KiotViet PMS integration (docs/superpowers/specs/2026-11-01-pms-kiotviet-design.md). Optional:
# the defaults are KiotViet's production endpoints; shop credentials are entered per workspace.
KIOTVIET_TOKEN_URL=https://id.kiotviet.vn/connect/token
KIOTVIET_API_URL=https://public.kiotapi.com
# Public HTTPS origin of the webhook ingress (apps/webhook). KiotViet webhooks are registered at
# ${PUBLIC_WEBHOOK_BASE_URL}/webhooks/kiotviet/<token>; unset, only the 10-minute reconcile keeps data fresh.
# PUBLIC_WEBHOOK_BASE_URL=https://hooks.example.com

# Rapiz HQ (ADR-021): the SaaS business in which Rapiz's team sees every platform account as a
# customer. Create it with `pnpm --filter @agent-sales/backend hq-init <owner-email>`, then run
# `hq-backfill --dry-run` and `hq-backfill`. Unset, the HQ sync and nightly reconcile do nothing.
# RAPIZ_HQ_WORKSPACE_ID=
