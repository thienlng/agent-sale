# Copy to .env for local development. Never commit real values.
# Each app validates its own env schema at boot (see apps/*/README.md).
NODE_ENV=development
LOG_LEVEL=debug

# Database / cache / storage (local docker compose, see T-004)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_sales
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=agent-sales-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# LLM providers (set only the ones you use; tests use a fake provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
