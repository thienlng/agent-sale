# Copy to .env for local development. Never commit real values.
# Each app validates its own env schema at boot (see apps/*/README.md).
NODE_ENV=development
LOG_LEVEL=debug

# Database (infra/docker/docker-compose.local.yml). Three logins (ADR-004):
#  - owner: runs migrations only
#  - razpi_tenant (member of app_tenant): API, agent, tenant-scoped jobs — RLS-bound
#  - razpi_system (member of app_system): ingress, scheduler, reconciliation, back-office
# `pnpm db:migrate:dev` creates the two app logins with these passwords.
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:5433/razpi
DATABASE_URL=postgres://razpi_tenant:razpi_tenant_dev@localhost:5433/razpi
DATABASE_SYSTEM_URL=postgres://razpi_system:razpi_system_dev@localhost:5433/razpi

REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=razpi-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
SMTP_URL=smtp://localhost:1025

# LLM providers and tier routing are NOT configured here: platform admins manage them in the
# admin console (stored in llm_providers / llm_tier_routes, API keys encrypted). Without a route,
# development and tests use a deterministic fake model; production answers 503.
# Make yourself platform admin after signing up:
#   pnpm --filter @agent-sales/backend platform-admin grant you@example.com
#
# Encrypts secrets stored in the database (LLM API keys). 32 bytes base64: `openssl rand -base64 32`.
# Required in production; empty in development uses a fixed insecure key.
SECRETS_ENCRYPTION_KEY=
