{
  "name": "@agent-sales/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Message catalogs (vi, en) shared by web, admin and widget. Every user-facing string lives here.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "import": "./dist/locales.js"
    },
    "./vi": {
      "types": "./dist/vi.d.ts",
      "import": "./dist/vi.js"
    },
    "./en": {
      "types": "./dist/en.d.ts",
      "import": "./dist/en.js"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/integration.js"
    },
    "./assistant": {
      "types": "./dist/assistant.d.ts",
      "import": "./dist/assistant.js"
    },
    "./backoffice": {
      "types": "./dist/backoffice.d.ts",
      "import": "./dist/backoffice.js"
    },
    "./developer": {
      "types": "./dist/developer.d.ts",
      "import": "./dist/developer.js"
    },
    "./notification": {
      "types": "./dist/notification.d.ts",
      "import": "./dist/notification.js"
    },
    "./lodging": {
      "types": "./dist/lodging.d.ts",
      "import": "./dist/lodging.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
