{
  "name": "@agent-sales/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types, schemas, error codes and pure utilities used by every app and package",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
