{
  "name": "@agent-sales/channels",
  "version": "0.0.0",
  "private": true,
  "description": "ChannelAdapter contract and normalized event types; one adapter per platform (facebook, instagram, zalo, tiktok, lazada, website, email).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@agent-sales/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
