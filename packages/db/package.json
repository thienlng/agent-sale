{
  "name": "@agent-sales/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema (one file per module), SQL migrations, tenant-scoped transactions (withTenant) and DB roles. Imported only by infrastructure/ folders.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:migrate:dev": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts --dev-roles",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@agent-sales/shared": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@agent-sales/testing": "workspace:*",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
