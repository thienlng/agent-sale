{
  "name": "@agent-sales/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Test-only helpers: factories, tenant helpers, cross-tenant assertions. Never imported by production code.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@agent-sales/shared": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "testcontainers": "^12.2.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
